---
import "../global.css";
import { MapPin, Globe, Github, Linkedin, Mail } from "@lucide/astro";

const trackingid = "G-51HSCQVPZT";

const links = [
  { label: "vinay-rawat.dev", href: "https://vinay-rawat.dev", icon: Globe },
  { label: "GitHub", href: "https://github.com/vineyrawat", icon: Github },
  { label: "LinkedIn", href: "https://linkedin.com/in/vineyrawat", icon: Linkedin },
  { label: "Email", href: "mailto:vinay@vinay-rawat.dev", icon: Mail },
];

const experience = [
  {
    company: "EntriesOne",
    location: "Bengaluru, India · On-site",
    roles: [
      { title: "Principal Engineer", type: "Full-time", period: "Feb 2026 – Present" },
    ],
  },
  {
    company: "Entries.AI",
    location: "Bengaluru, India · On-site",
    roles: [
      {
        title: "Principal Engineer",
        type: "Full-time",
        period: "Jun 2024 – Present",
        summary:
          "Building AI-powered automation to streamline workflows. Backend integration, API development, and system performance with React, Frappe, and TailwindCSS.",
      },
    ],
  },
  {
    company: "Extension Technologies",
    location: "Faridabad, India · On-site",
    roles: [
      { title: "Senior Software Engineer", type: "Full-time", period: "Sep 2023 – Jun 2024" },
      { title: "Full Stack Developer", type: "Full-time", period: "Sep 2021 – Dec 2023" },
    ],
  },
  {
    company: "Freelance",
    location: "Faridabad, India",
    roles: [
      { title: "Web Developer", type: "Freelance", period: "Feb 2021 – Aug 2021" },
    ],
  },
];

const projects = [
  {
    name: "auto-commit",
    lang: "TypeScript",
    desc: "AI-driven CLI that generates conventional commits, supporting multiple LLM providers.",
    href: "https://github.com/vineyrawat/auto-commit",
  },
  {
    name: "convogen",
    lang: "Dart",
    desc: "AI chat assistant powered by Gemini APIs.",
    href: "https://github.com/vineyrawat/convogen",
  },
  {
    name: "saas_theme",
    lang: "CSS",
    desc: "Modern SaaS UI for Frappe v16 — dual sidebar and enhanced forms.",
    href: "https://github.com/vineyrawat/saas_theme",
  },
  {
    name: "Tekton-Theme",
    lang: "SCSS",
    desc: "Custom theming app for the Frappe framework.",
    href: "https://github.com/vineyrawat/Tekton-Theme",
  },
  {
    name: "oc_blue_theme_frappe",
    lang: "Python",
    desc: "Clean, simple blue theme for the Frappe framework.",
    href: "https://github.com/vineyrawat/oc_blue_theme_frappe",
  },
  {
    name: "device-tracker-mobile",
    lang: "Dart",
    desc: "Mobile device tracking application.",
    href: "https://github.com/vineyrawat/device-tracker-mobile",
  },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Vinay Rawat — Senior Software Engineer building AI-powered automation and scalable web apps with Frappe, React, and TailwindCSS."
		/>
		<title>Vinay Rawat — Senior Software Engineer</title>
		<script async src={`https://www.googletagmanager.com/gtag/js?id=${trackingid}`}></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', trackingid);
		</script>
	</head>
	<body>
		<div class="min-h-screen bg-white text-black">
			<div class="max-w-2xl mx-auto px-6 py-16">

				{/* Header */}
				<header class="mb-14">
					<h1 class="text-3xl font-bold tracking-tight">Vinay Rawat</h1>
					<p class="text-lg text-gray-700 mt-1">Senior Software Engineer</p>
					<p class="text-sm text-gray-500 mt-1">Frappe · React · Node.js · AI Agent Development</p>
					<div class="flex items-center text-gray-500 text-sm mt-3">
						<MapPin class="w-4 h-4 mr-1.5" />
						<span>Bengaluru, India</span>
					</div>

					{/* Links */}
					<nav class="flex flex-wrap gap-x-5 gap-y-2 mt-5">
						{links.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-sm text-gray-600 hover:text-black transition-colors"
							>
								<link.icon class="w-4 h-4 mr-1.5" />
								{link.label}
							</a>
						))}
					</nav>
				</header>

				{/* About */}
				<section class="mb-14">
					<h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">About</h2>
					<p class="text-gray-700 leading-relaxed">
						Senior Software Engineer based in Bengaluru, building AI-powered automation and
						scalable web applications with Frappe, React, and TailwindCSS. Linux and open-source
						enthusiast who enjoys contributing to the developer community.
					</p>
				</section>

				{/* Experience */}
				<section class="mb-14">
					<h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-6">Experience</h2>
					<div class="space-y-8">
						{experience.map((exp) => (
							<div class="relative pl-6 border-l border-gray-200">
								<span class="absolute -left-[5px] top-1.5 w-2.5 h-2.5 rounded-full bg-black"></span>
								<h3 class="font-medium text-gray-900">{exp.company}</h3>
								<p class="text-xs text-gray-400 mb-3">{exp.location}</p>
								<div class="space-y-3">
									{exp.roles.map((role) => (
										<div>
											<p class="text-sm font-medium text-gray-800">{role.title}</p>
											<p class="text-xs text-gray-500">{role.type} · {role.period}</p>
											{role.summary && (
												<p class="text-sm text-gray-600 leading-relaxed mt-1">{role.summary}</p>
											)}
										</div>
									))}
								</div>
							</div>
						))}
					</div>
				</section>

				{/* Projects */}
				<section class="mb-14">
					<h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-6">Projects</h2>
					<div class="space-y-5">
						{projects.map((project) => (
							<div>
								<div class="flex items-baseline gap-2">
									<a
										href={project.href}
										target="_blank"
										rel="noopener noreferrer"
										class="font-medium text-gray-900 hover:underline"
									>
										{project.name}
									</a>
									<span class="text-xs text-gray-400">{project.lang}</span>
								</div>
								<p class="text-sm text-gray-600 leading-relaxed mt-0.5">{project.desc}</p>
							</div>
						))}
					</div>
				</section>

				{/* Skills */}
				<section class="mb-14">
					<h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">Skills</h2>
					<dl class="space-y-2 text-sm">
						<div class="flex gap-3">
							<dt class="w-24 shrink-0 text-gray-400">Languages</dt>
							<dd class="text-gray-700">TypeScript, JavaScript, Python, Dart</dd>
						</div>
						<div class="flex gap-3">
							<dt class="w-24 shrink-0 text-gray-400">Frameworks</dt>
							<dd class="text-gray-700">React, Node.js, Frappe, TailwindCSS</dd>
						</div>
						<div class="flex gap-3">
							<dt class="w-24 shrink-0 text-gray-400">Focus</dt>
							<dd class="text-gray-700">AI agent development, automation, web apps, Linux</dd>
						</div>
					</dl>
				</section>

				{/* Footer */}
				<footer class="text-sm text-gray-400 border-t border-gray-100 pt-6">
					<p>Frappe development · AI automation · Linux systems</p>
				</footer>

			</div>
		</div>
	</body>
</html>
